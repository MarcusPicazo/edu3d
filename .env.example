# Copia este archivo a .env  (los scripts lo cargan con --env-file-if-exists=.env)
#
#   cp .env.example .env
#
# ...y pon tu clave de la API de Anthropic:
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Opcionales ----
# MODEL=claude-sonnet-4-6      # modelo de generación y de juez de nivel
# EFFORT=medium               # low | medium | high | max  (profundidad de razonamiento)
# MAX_TOKENS=24000            # presupuesto de salida por llamada
# MAX_ATTEMPTS=3              # reintentos de /solution
